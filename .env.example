# Server-only secret. Never prefix this with EXPO_PUBLIC_.
PAYSCRIBE_SECRET_KEY=YOUR_PAYSCRIBE_API_KEY
PAYSCRIBE_ENVIRONMENT=sandbox
PORT=4000

# URL the mobile device uses to reach server.ts.
# iOS simulator: http://localhost:4000
# Android emulator: http://10.0.2.2:4000
# Physical device: http://YOUR_MAC_LAN_IP:4000
EXPO_PUBLIC_CHECKOUT_SERVER_URL=http://localhost:4000

# Optional HTTPS merchant URLs stored on the checkout session.
MERCHANT_ORIGIN=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
