  "main": "index.ts",
  "dependencies": {
    "@payscribe/checkout-react-native": "file:../links/hosted-checkout-react-native",
    "@payscribe/sdk": "file:../sdk",
    "dotenv": "^17.4.2",
    "expo": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "express": "^5.2.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
